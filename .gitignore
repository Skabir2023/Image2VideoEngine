# Dependencies
node_modules/

# Media — never commit rendered video, audio, or stills
*.mp4
*.mov
*.wav
*.mp3
*.m4a
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico

# Exception — the shared sound library IS versioned: engine recordings and SFX
# (Pixabay Content Licence, see sound/README.md). No parent directory of sound/
# is excluded, so this negation takes effect.
!sound/**

# Render intermediates (regenerated on every render)
video-projects/*/*/renders/cut/
video-projects/*/*/audio/premix.wav
video-projects/*/*/audio/sfx/
video-projects/*/*/audio/final-audio.wav
video-projects/*/*/audio/final-voice.wav
video-projects/*/*/audio/final-cta.wav
video-projects/*/*/audio/paragraph/*-prev.wav

# Operational state — the queue and ledger are rewritten by tools/publish.py.
# They ARE versioned: a fresh clone must continue this page's history, not start a
# second one, and uploaded.csv is what stops a film going out twice. A run leaves
# them modified, so commit them with the rest of the work.

# The page's workbooks are versioned for the same reason — they are the calendar
# that says which cars are used and which angle is due. Only the tool's local
# backups stay behind (they are copies, not the calendar).
video-projects/*/backup/

# Environment / secrets
.env
.env.*
~/.env_brightbean

# OS
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
*.swp